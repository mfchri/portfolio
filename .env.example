# Server Port
PORT=3001

# JWT Secret for admin session cookie signing
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_min_32_chars

# Admin Password (used on initial seed; hashed and saved into server/data/admin.json)
ADMIN_PASSWORD=admin12345

# Allowed Client Origin (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
